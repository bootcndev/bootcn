{
  "$schema": "../../schema/registry-item.schema.json",
  "name": "ecommerce",
  "type": "registry:template",
  "title": "E-commerce",
  "description": "An online shop in three pages: a catalogue with filters and sorting, a product page with gallery and options, and a one-page checkout, sharing a cart drawer that keeps its items between pages.",
  "version": "1.0.0",
  "added": "0.34.0",
  "categories": ["marketing"],
  "dependencies": [],
  "registryDependencies": [
    "button",
    "badge",
    "breadcrumb",
    "input",
    "select",
    "checkbox",
    "radio-group",
    "sheet",
    "rating",
    "variant-picker",
    "product-card",
    "cart",
    "confetti",
    "success-state",
    "product-listing",
    "product-detail",
    "checkout"
  ],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS", "Bootstrap JS bundle"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "ecommerce.html",
      "target": "ecommerce.html",
      "type": "registry:page"
    },
    {
      "path": "ecommerce-product.html",
      "target": "ecommerce-product.html",
      "type": "registry:page"
    },
    {
      "path": "ecommerce-checkout.html",
      "target": "ecommerce-checkout.html",
      "type": "registry:page"
    },
    {
      "path": "ecommerce.css",
      "target": "ecommerce.css",
      "type": "registry:style"
    },
    {
      "path": "ecommerce.js",
      "target": "ecommerce.js",
      "type": "registry:script"
    }
  ]
}
