{
  "$schema": "../../schema/registry-item.schema.json",
  "name": "chat",
  "type": "registry:block",
  "title": "Chat",
  "description": "A messaging app: conversations with presence and unread counts, a thread with day separators, read receipts, files and reactions, a typing indicator, and a composer that grows, sends on Enter and attaches files; one pane at a time on phones.",
  "version": "1.0.0",
  "added": "0.40.0",
  "categories": ["dashboard"],
  "dependencies": [],
  "registryDependencies": ["avatar"],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "chat.html",
      "target": "chat.html",
      "type": "registry:component"
    },
    {
      "path": "chat.css",
      "target": "chat.css",
      "type": "registry:style"
    },
    {
      "path": "chat.js",
      "target": "chat.js",
      "type": "registry:script"
    }
  ]
}
