{
  "$schema": "../../schema/registry-item.schema.json",
  "name": "login-card",
  "type": "registry:block",
  "title": "Login card",
  "description": "A centered sign-in card with email, password, a remember-me option and links to reset the password or sign up.",
  "version": "1.0.0",
  "categories": ["authentication"],
  "dependencies": [],
  "registryDependencies": ["card", "input", "checkbox", "button"],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "login-card.html",
      "target": "login-card.html",
      "type": "registry:component"
    },
    {
      "path": "login-card.css",
      "target": "login-card.css",
      "type": "registry:style"
    }
  ]
}
