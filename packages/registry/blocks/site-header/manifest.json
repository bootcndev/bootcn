  "version": "1.0.0",
  "categories": ["marketing"],
  "dependencies": [],
  "registryDependencies": ["button"],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS", "Bootstrap JS bundle"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "site-header.html",
      "target": "site-header.html",
      "type": "registry:component"
    },
    {
      "path": "site-header.css",
      "target": "site-header.css",
      "type": "registry:style"
    }
  ]
}
