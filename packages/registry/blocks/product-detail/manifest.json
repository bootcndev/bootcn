{
  "$schema": "../../schema/registry-item.schema.json",
  "name": "product-detail",
  "type": "registry:block",
  "title": "Product detail",
  "description": "A product page section: breadcrumbs, a picture gallery with thumbnails, name, rating, price, colour and size choices, quantity, add to cart and wishlist, delivery perks and expandable details.",
  "version": "1.0.0",
  "added": "0.34.0",
  "categories": ["marketing"],
  "dependencies": [],
  "registryDependencies": [
    "product-card",
    "rating",
    "variant-picker",
    "cart",
    "breadcrumb",
    "input",
    "button"
  ],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "product-detail.html",
      "target": "product-detail.html",
      "type": "registry:component"
    },
    {
      "path": "product-detail.css",
      "target": "product-detail.css",
      "type": "registry:style"
    },
    {
      "path": "product-detail.js",
      "target": "product-detail.js",
      "type": "registry:script"
    }
  ]
}
