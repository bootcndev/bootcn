  },
  "license": "MIT",
  "files": [
    {
      "path": "forgot-password-card.html",
      "target": "forgot-password-card.html",
      "type": "registry:component"
    },
    {
      "path": "forgot-password-card.css",
      "target": "forgot-password-card.css",
      "type": "registry:style"
    }
  ]
}
