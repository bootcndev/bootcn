  "categories": ["forms", "data-display"],
  "dependencies": [],
  "registryDependencies": ["input", "button"],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "payment-card.html",
      "target": "payment-card.html",
      "type": "registry:component"
    },
    {
      "path": "payment-card.css",
      "target": "payment-card.css",
      "type": "registry:style"
    },
    {
      "path": "payment-card.js",
      "target": "payment-card.js",
      "type": "registry:script"
    }
  ]
}
