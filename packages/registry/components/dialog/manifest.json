{
  "$schema": "../../schema/registry-item.schema.json",
  "name": "dialog",
  "type": "registry:ui",
  "title": "Dialog",
  "description": "An accessible confirm dialog built on Bootstrap's modal, with a declarative confirm event.",
  "version": "1.0.0",
  "categories": ["overlays", "dialogs"],
  "dependencies": [],
  "registryDependencies": ["button"],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS", "Bootstrap JS bundle"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "dialog.html",
      "target": "components/ui/dialog.html",
      "type": "registry:component"
    },
    {
      "path": "dialog.css",
      "target": "assets/css/dialog.css",
      "type": "registry:style"
    },
    {
      "path": "dialog.js",
      "target": "assets/js/dialog.js",
      "type": "registry:script"
    }
  ]
}
