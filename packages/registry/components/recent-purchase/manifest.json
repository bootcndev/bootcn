{
  "$schema": "../../schema/registry-item.schema.json",
  "name": "recent-purchase",
  "type": "registry:ui",
  "title": "Recent purchase",
  "description": "A small notice in a corner when someone buys from your shop (\"Lena in Berlin bought Linen shirt, 2 minutes ago\"), fed with real orders from your server, one at a time and easy to switch off.",
  "version": "1.0.0",
  "added": "0.42.0",
  "categories": ["commerce", "feedback"],
  "dependencies": [],
  "registryDependencies": [],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "recent-purchase.html",
      "target": "recent-purchase.html",
      "type": "registry:component"
    },
    {
      "path": "recent-purchase.css",
      "target": "recent-purchase.css",
      "type": "registry:style"
    },
    {
      "path": "recent-purchase.js",
      "target": "recent-purchase.js",
      "type": "registry:script"
    }
  ]
}
