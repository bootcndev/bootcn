{
  "$schema": "../../schema/registry-item.schema.json",
  "name": "map-embed",
  "type": "registry:ui",
  "title": "Map embed",
  "description": "An OpenStreetMap map that loads only when asked, with a caption and a link to the full map; no library and no third-party request before the click.",
  "version": "1.0.0",
  "added": "0.25.0",
  "categories": ["data-display"],
  "dependencies": [],
  "registryDependencies": ["button"],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "map-embed.html",
      "target": "map-embed.html",
      "type": "registry:component"
    },
    {
      "path": "map-embed.css",
      "target": "map-embed.css",
      "type": "registry:style"
    },
    {
      "path": "map-embed.js",
      "target": "map-embed.js",
      "type": "registry:script"
    }
  ]
}
