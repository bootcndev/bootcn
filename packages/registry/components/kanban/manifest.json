  "version": "1.0.0",
  "categories": ["data-display"],
  "dependencies": [],
  "registryDependencies": ["avatar", "button", "textarea"],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "kanban.html",
      "target": "kanban.html",
      "type": "registry:component"
    },
    {
      "path": "kanban.css",
      "target": "kanban.css",
      "type": "registry:style"
    },
    {
      "path": "kanban.js",
      "target": "kanban.js",
      "type": "registry:script"
    }
  ]
}
