  "version": "1.0.0",
  "categories": ["overlays"],
  "dependencies": [],
  "registryDependencies": ["button"],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "tour.html",
      "target": "tour.html",
      "type": "registry:component"
    },
    {
      "path": "tour.css",
      "target": "tour.css",
      "type": "registry:style"
    },
    {
      "path": "tour.js",
      "target": "tour.js",
      "type": "registry:script"
    }
  ]
}
