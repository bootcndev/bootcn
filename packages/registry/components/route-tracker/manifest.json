{
  "$schema": "../../schema/registry-item.schema.json",
  "name": "route-tracker",
  "type": "registry:ui",
  "title": "Route tracker",
  "description": "Tracks the device's position and draws the route on an OpenStreetMap map as it goes, with distance, time and average speed; pan, zoom, fit and export as GeoJSON.",
  "version": "1.0.0",
  "added": "0.29.0",
  "categories": ["data-display"],
  "dependencies": [],
  "registryDependencies": ["button", "location-pin"],
  "compatibility": {
    "bootstrap": "5.3",
    "platform": ["Bootstrap CSS"]
  },
  "license": "MIT",
  "files": [
    {
      "path": "route-tracker.html",
      "target": "route-tracker.html",
      "type": "registry:component"
    },
    {
      "path": "route-tracker.css",
      "target": "route-tracker.css",
      "type": "registry:style"
    },
    {
      "path": "route-tracker.js",
      "target": "route-tracker.js",
      "type": "registry:script"
    }
  ]
}
