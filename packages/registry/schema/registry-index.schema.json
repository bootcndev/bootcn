{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bootcn.dev/schema/registry-index.json",
  "title": "Bootcn registry index",
  "description": "The built index.json describing all available registry items.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "items"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/indexItem"
      }
    }
  },
  "$defs": {
    "itemType": {
      "type": "string",
      "enum": [
        "registry:ui",
        "registry:block",
        "registry:template",
        "registry:theme",
        "registry:lib"
      ]
    },
    "indexItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "title", "description", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "$ref": "#/$defs/itemType"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "target"],
            "properties": {
              "type": {
                "type": "string",
                "description": "A registry file type. A pattern, not a list, so clients keep reading indexes that add new file types.",
                "pattern": "^registry:[a-z]+$"
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
