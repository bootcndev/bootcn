{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bootcn.dev/schema/registry-item.json",
  "title": "Bootcn registry item",
  "description": "A single installable item in the Bootcn registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "type", "title", "description", "files"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "$ref": "#/$defs/itemType"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$"
    },
    "added": {
      "description": "The registry version that first shipped this item; the site marks recent ones as new.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bootstrap": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string"
        },
        "keyboard": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "itemType": {
      "type": "string",
      "enum": [
        "registry:ui",
        "registry:block",
        "registry:template",
        "registry:theme",
        "registry:lib"
      ]
    },
    "fileType": {
      "type": "string",
      "enum": [
        "registry:component",
        "registry:style",
        "registry:script",
        "registry:lib",
        "registry:page",
        "registry:react",
        "registry:vue"
      ]
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*\\x00)(?!\\.\\.(?:/|$))(?!.*/\\.\\.(?:/|$))(?!\\.(?:/|$))(?!.*/\\.(?:/|$))(?!.*//)(?!.*/$).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "target", "type"],
      "properties": {
        "path": {
          "$ref": "#/$defs/safePath",
          "description": "Source path, relative to the item directory."
        },
        "target": {
          "$ref": "#/$defs/safePath",
          "description": "Install path, relative to the project directory configured for this file type in bootcn.json (registry:component -> paths.components, registry:style -> paths.css, registry:script -> paths.js, registry:lib -> paths.lib, registry:page -> paths.pages or the project root). Pages may use {{bootcn:components}}, {{bootcn:css}}, {{bootcn:js}} and {{bootcn:lib}}, replaced on install with the path from the page to that directory."
        },
        "type": {
          "$ref": "#/$defs/fileType"
        },
        "content": {
          "type": "string",
          "description": "File content. Present only in built registry items (dist/r/<name>.json)."
        }
      }
    }
  }
}
