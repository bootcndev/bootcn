{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bootcn.dev/schema/registry-item.json",
  "title": "Bootcn registry item",
  "description": "A single installable item in the Bootcn registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "type", "title", "description", "files"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": { "$ref": "#/$defs/itemType" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$"
    },
    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "registryDependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bootstrap": { "type": "string", "minLength": 1 },
        "platform": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": { "type": "string" },
        "keyboard": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "author": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "examples": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "itemType": {
      "type": "string",
      "enum": [
        "registry:ui",
        "registry:block",
        "registry:template",
        "registry:theme",
        "registry:lib"
      ]
    },
    "fileType": {
      "type": "string",
      "enum": ["registry:component", "registry:style", "registry:script", "registry:lib"]
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*\\x00)(?!\\.\\.(?:/|$))(?!.*/\\.\\.(?:/|$))(?!\\.(?:/|$))(?!.*/\\.(?:/|$))(?!.*//)(?!.*/$).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "target", "type"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "target": { "$ref": "#/$defs/safePath" },
        "type": { "$ref": "#/$defs/fileType" },
        "content": { "type": "string" }
      }
    }
  }
}
