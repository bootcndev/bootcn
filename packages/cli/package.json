{
  "name": "bootcn",
  "version": "0.1.0",
  "private": true,
  "description": "Install copy-paste Bootstrap 5.3 components (HTML, CSS, vanilla JS) into your project.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bootcn": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "bootstrap",
    "components",
    "copy-paste",
    "cli",
    "vanilla-js",
    "php"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.1.0",
    "diff": "9.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
