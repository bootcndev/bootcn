{
  "name": "bootcndev/bootcn",
  "description": "The bootcn CLI for PHP and Laravel projects, no Node.js needed: install copy-paste Bootstrap 5.3 components into your project.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "bootstrap",
    "components",
    "laravel",
    "blade",
    "cli",
    "ui"
  ],
  "homepage": "https://bootcn.dev",
  "support": {
    "issues": "https://github.com/bootcndev/bootcn/issues",
    "source": "https://github.com/bootcndev/bootcn",
    "docs": "https://bootcn.dev/guide/installation"
  },
  "require": {
    "php": ">=8.1"
  },
  "bin": [
    "bin/bootcn"
  ],
  "archive": {
    "exclude": [
      "/tests",
      "/.bin"
    ]
  }
}
